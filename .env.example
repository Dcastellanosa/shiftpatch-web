# Copy to .env.local and fill in real values. Never commit .env.local.
# Every VITE_* variable is bundled into the browser build and is PUBLIC.
# Never put the Supabase secret / service-role key here.

# Base URL of the shiftpatch-api Express service (no trailing slash).
VITE_API_URL=http://localhost:3000

# Supabase project URL and publishable (anon) key — used for Auth only.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
