# The browser needs no configuration: React calls same-origin /api/* only, and the
# API owns all Supabase access. Never add Supabase variables or secrets here.
# Nothing in this file is bundled into the client (no VITE_* variables).

# Local dev/preview proxy target for /api/* (read by vite.config.ts only).
# Defaults to http://localhost:3000 when blank.
API_PROXY_TARGET=

# Vercel only (set in the web project's Environment Variables, not locally):
# origin of the deployed shiftpatch-api used by the /api/* route in vercel.json,
# e.g. https://shiftpatch-api.vercel.app (no trailing slash).
API_ORIGIN=
