// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`shows all status counts and the empty admin table 1`] = `
<section
  aria-labelledby="admin-heading"
  class="page"
>
  <header
    class="page__header"
  >
    <div>
      <h1
        id="admin-heading"
      >
        All Shifts
      </h1>
      <p
        class="muted"
      >
        Every agency and nurse assignment.
      </p>
    </div>
  </header>
  <form
    aria-label="Filters"
    class="card filters"
  >
    <label
      class="field"
    >
      Agency
      <select>
        <option
          value=""
        >
          All agencies
        </option>
      </select>
    </label>
    <label
      class="field"
    >
      From
      <input
        type="date"
        value=""
      />
    </label>
    <label
      class="field"
    >
      To
      <input
        type="date"
        value=""
      />
    </label>
  </form>
  <div
    aria-label="Shifts by status"
    class="stats"
    role="group"
  >
    <button
      aria-pressed="true"
      class="stat"
      type="button"
    >
      <span
        class="stat__value"
      >
        0
      </span>
      <span
        class="stat__label"
      >
        All
      </span>
    </button>
    <button
      aria-pressed="false"
      class="stat stat--open"
      type="button"
    >
      <span
        class="stat__value"
      >
        0
      </span>
      <span
        class="stat__label"
      >
        Open
      </span>
    </button>
    <button
      aria-pressed="false"
      class="stat stat--filled"
      type="button"
    >
      <span
        class="stat__value"
      >
        0
      </span>
      <span
        class="stat__label"
      >
        Filled
      </span>
    </button>
  </div>
  <div
    class="state state--empty"
  >
    <p
      class="state__title"
    >
      No shifts match these filters
    </p>
  </div>
</section>
`;
