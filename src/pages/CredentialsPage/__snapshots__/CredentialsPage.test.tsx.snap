// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`shows the upload form with the required inputs and the empty list 1`] = `
<section
  aria-labelledby="credentials-heading"
  class="page"
>
  <header
    class="page__header"
  >
    <div>
      <h1
        id="credentials-heading"
      >
        Credentials
      </h1>
      <p
        class="muted"
      >
        Keep your licence and screenings current: an expired credential blocks claims.
      </p>
    </div>
  </header>
  <form
    aria-labelledby="_r_0_"
    class="card form credential-upload-form"
  >
    <h2
      id="_r_0_"
    >
      Upload a credential
    </h2>
    <div
      class="credential-upload-form__grid"
    >
      <div
        class="field"
      >
        <label
          for="_r_1_"
        >
          Credential
        </label>
        <select
          id="_r_1_"
        >
          <option
            value="nursing_license"
          >
            Nursing licence
          </option>
          <option
            value="tb_test"
          >
            TB test
          </option>
        </select>
      </div>
      <div
        class="field"
      >
        <label
          for="_r_2_"
        >
          Document
        </label>
        <input
          accept=".pdf,.png,.jpg,.jpeg,application/pdf,image/png,image/jpeg"
          aria-describedby="_r_4_"
          aria-required="true"
          data-testid="credential-upload-input"
          id="_r_2_"
          type="file"
        />
      </div>
      <div
        class="field"
      >
        <label
          for="_r_3_"
        >
          Expiry date
        </label>
        <input
          data-testid="credential-expiry-date-input"
          id="_r_3_"
          required=""
          type="date"
          value=""
        />
      </div>
    </div>
    <p
      class="muted small"
      id="_r_4_"
    >
      PDF, PNG or JPEG, up to 5 MB. A new upload replaces the document on file for that credential.
    </p>
    <div
      class="form__actions"
    >
      <button
        class="btn btn--primary"
        disabled=""
        type="submit"
      >
        Upload credential
      </button>
    </div>
  </form>
  <section
    aria-labelledby="credentials-list-heading"
    class="section"
  >
    <h2
      id="credentials-list-heading"
    >
      On file
    </h2>
    <div
      class="state state--empty"
    >
      <p
        class="state__title"
      >
        No credentials yet
      </p>
      <p>
        Upload your nursing licence to start claiming shifts.
      </p>
    </div>
  </section>
</section>
`;
