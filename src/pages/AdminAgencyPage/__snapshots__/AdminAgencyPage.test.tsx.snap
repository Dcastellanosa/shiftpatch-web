        >
          Active
        </span>
      </td>
      <td
        class="branch-table__actions"
      >
        <button
          aria-controls="branch-edit-b1000000-0000-4000-8000-000000000001"
          aria-expanded="false"
          class="btn btn--link"
          type="button"
        >
          Edit
        </button>
        <button
          class="btn btn--secondary status-toggle"
          type="button"
        >
