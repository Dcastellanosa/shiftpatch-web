// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`shows the agency page with the post-shift button and no shifts 1`] = `
<section
  aria-labelledby="agency-heading"
  class="page"
>
  <header
    class="page__header"
  >
    <div>
      <h1
        id="agency-heading"
      >
        Agency Shifts
      </h1>
      <p
        class="muted"
      >
        Sunrise Health Staffing · 
        Post open shifts and track who claimed them.
      </p>
    </div>
    <button
      class="btn btn--primary"
      data-testid="agency-post-shift-button"
      type="button"
    >
      Post shift
    </button>
  </header>
  <section
    aria-labelledby="agency-list-heading"
    class="section"
  >
    <div
      class="section__header"
    >
      <h2
        id="agency-list-heading"
      >
        Shifts
      </h2>
      <label
        class="inline-field"
      >
        Status
        <select>
          <option
            value=""
          >
            All statuses
          </option>
          <option
            value="open"
          >
            Open
          </option>
          <option
            value="filled"
          >
            Filled
          </option>
        </select>
      </label>
    </div>
    <div
      class="state state--empty"
    >
      <p
        class="state__title"
      >
        No shifts match
      </p>
      <p>
        Post a shift or change the status filter.
      </p>
    </div>
  </section>
</section>
`;
