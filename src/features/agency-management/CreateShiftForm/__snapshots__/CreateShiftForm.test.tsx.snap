// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders the contract form without a branch picker for a single-branch agency 1`] = `
<form
  aria-labelledby="_r_1_-legend"
  class="card form"
>
  <h2
    id="_r_1_-legend"
  >
    Post a Shift
  </h2>
  <div
    class="form__grid"
  >
    <div
      class="field"
    >
      <label
        for="_r_1_"
      >
        Role
      </label>
      <input
        autocomplete="off"
        id="_r_1_"
        maxlength="200"
        name="role"
        placeholder="e.g. RN"
        required=""
      />
    </div>
    <div
      class="field"
    >
      <label
        for="_r_2_"
      >
        Date
      </label>
      <input
        id="_r_2_"
        name="date"
        required=""
        type="date"
      />
    </div>
    <div
      class="field"
    >
      <label
        for="_r_3_"
      >
        Start
      </label>
      <input
        id="_r_3_"
        name="startTime"
        required=""
        type="time"
        value=""
      />
    </div>
    <div
      class="field"
    >
      <label
        for="_r_4_"
      >
        End
      </label>
      <input
        aria-describedby="_r_5_"
        id="_r_4_"
        name="endTime"
        required=""
        type="time"
        value=""
      />
    </div>
  </div>
  <p
    class="muted small"
    id="_r_5_"
  >
    Times are the facility's local time.
  </p>
  <div
    class="form__actions"
  >
    <button
      class="btn btn--primary"
      type="submit"
    >
      Post shift
    </button>
  </div>
</form>
`;
