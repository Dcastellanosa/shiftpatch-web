      <time
        datetime="2030-01-10T14:00:00.000Z"
      >
        Jan 10, 2030, 9:00 AM
      </time>
    </span>
    <p
      class="small"
    >
      Accepted by nurse
    </p>
  </li>
</ol>
`;
